# Copie este arquivo pra ".env" (mesma pasta) e preencha antes de rodar o servidor.

# Porta em que o servidor escuta.
PORT=4000

# Segredo usado pra assinar os tokens de login (JWT). OBRIGATÓRIO.
# Gere um valor aleatório forte, por exemplo rodando:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_isto_por_um_valor_aleatorio_bem_grande

# Por quantos dias um login fica valido antes de precisar entrar de novo.
TOKEN_TTL_DAYS=30

# URL(s) de onde o TableLink (frontend) é servido, separadas por vírgula.
# Sem isso, o servidor aceita qualquer origem — ok pra testar local, mas
# defina isso antes de publicar de verdade.
# Exemplo: CORS_ORIGIN=https://minhamesa.com,http://localhost:5500
CORS_ORIGIN=

# Caminho do arquivo do banco SQLite (opcional — por padrão fica em
# server/data/tablelink.db).
# DB_PATH=./data/tablelink.db
